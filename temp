# =============================================================================
# ENVANTER (INI formati)
# =============================================================================
# Kullanici SADECE su iki bilgiyi girer:
#   1. Her cluster'in bir master (control-plane) node'u  -> kubectl buradan calisir
#   2. O cluster'da decom edilecek node'lar
#
# Her cluster iki grup: <cluster>_master ve <cluster>_decom
# "all_masters" ve "all_decom" meta-gruplari bu alt gruplari toplar; playbook'lar
# bu iki grup uzerinden calisir. Yeni cluster = yeni iki grup + meta-gruplara ekleme.
# Baska hicbir bilgiye gerek yok; her decom node'un master'i grup isminden turetilir.
# =============================================================================

# ----- CLUSTER 1 -------------------------------------------------------------
[cluster1_master]
cluster1-master-01 ansible_host=10.0.1.10

[cluster1_decom]
cluster1-worker-05 ansible_host=10.0.1.55
cluster1-worker-06 ansible_host=10.0.1.56

# ----- CLUSTER 2 -------------------------------------------------------------
[cluster2_master]
cluster2-master-01 ansible_host=10.0.2.10

[cluster2_decom]
cluster2-worker-03 ansible_host=10.0.2.53

# ----- CLUSTER 3 (istediginiz kadar cogaltin) --------------------------------
# [cluster3_master]
# cluster3-master-01 ansible_host=10.0.3.10
#
# [cluster3_decom]
# cluster3-worker-01 ansible_host=10.0.3.51


# =============================================================================
# ASAGIYA DOKUNMAYIN - alt gruplari otomatik toplayan meta-gruplar.
# Yeni cluster eklerken ilgili _master ve _decom grubunu buraya da ekleyin.
# =============================================================================
[all_masters:children]
cluster1_master
cluster2_master
# cluster3_master

[all_decom:children]
cluster1_decom
cluster2_decom
# cluster3_decom
