# =============================================================================
#  KUBERNETES NODE EKLEME - ENVANTER (INVENTORY)
# =============================================================================
#
#  Bu dosyayı düzenleyip playbook'u başlatıyorsunuz. Aşağıdaki kurallara
#  uyarsanız doğrulama (validation) ve node ekleme playbook'ları sorunsuz
#  çalışır.
#
#  ---------------------------------------------------------------------------
#  NASIL DÜZENLENİR
#  ---------------------------------------------------------------------------
#  1) Node eklemek istediğiniz cluster'ın ilgili grubuna, eklenecek sunucunun
#     adını yazın (her satıra bir sunucu).
#
#  2) YENİ BİR CLUSTER eklemek için:
#       - Aşağıdaki "CLUSTER 2" şablonundaki '#' yorum işaretlerini kaldırın
#         (grup başlıkları ve node satırları dâhil).
#       - Node isimlerini kendi sunucularınızla değiştirin.
#       - Dosyanın altındaki meta gruplarda (all_masters, all_infras,
#         all_physical_workers, all_virtual_workers) ilgili cluster satırlarının
#         da '#' işaretini kaldırın. BU ADIM ZORUNLUDUR; meta grupları
#         güncellemezseniz yeni cluster playbook tarafından görülmez.
#       - Daha fazla cluster (cluster3, cluster4, ...) için aynı şablonu
#         kopyalayıp cluster numarasını artırın.
#
#  ---------------------------------------------------------------------------
#  İSİMLENDİRME KURALLARI (doğrulama bunları denetler)
#  ---------------------------------------------------------------------------
#  * Grup isimleri 'clusterN_<rol>' biçiminde olmalıdır. Geçerli roller:
#       _master  _physical_workers  _virtual_workers  _infra
#    N yerine cluster numarası gelir (cluster1, cluster2, ...). Bu isimlendirme,
#    playbook'un "hangi node hangi cluster'a ait" ilişkisini kurmasını sağlar.
#
#  * Her SUNUCU ADI 'lks' veya 'lk8s' ile başlamak zorundadır.
#    Geçerli örnek:   lks-master01,  lk8s-worker-01
#    Geçersiz örnek:  master01,  node1   (doğrulama bunları reddeder)
#
#  * Bir sunucu, aynı cluster içinde YALNIZCA BİR rol grubunda yer alabilir
#    (örneğin hem physical hem virtual olamaz).
#
#  * Bir sunucu YALNIZCA BİR cluster'a ait olabilir; aynı sunucu adını başka
#    bir cluster'ın gruplarına yazmayın.
#
#  * Her cluster'ın bir master'ı olmalı ve en az bir worker ya da infra node'u
#    bulunmalıdır (yalnızca worker, yalnızca infra ya da her ikisi de olabilir).
#
#  ---------------------------------------------------------------------------
#  DEĞİŞKENLER
#  ---------------------------------------------------------------------------
#  Dosyanın en altındaki [all:vars] bölümünde:
#    * kubernetes_version : Kurulacak sürüm. Yalnızca izin verilen değerlerden
#                           biri olabilir (örneğin "1.33" veya "1.35").
#    * hide_logs          : true  -> hassas çıktılar gizlenir
#                           false -> ayrıntılı çıktıyı ekranda görürsünüz
# =============================================================================


# ----- CLUSTER 1 -------------------------------------------------------------
# Bu cluster etkin. Node eklemek için ilgili grubun altına sunucu adı yazın.

[cluster1_master]
lks-master01

[cluster1_physical_workers]
lks-physical-worker-01

[cluster1_virtual_workers]
lks-virtual-worker-01

[cluster1_infra]
lks-infra01


# ----- CLUSTER 2 (ŞABLON - yeni cluster eklemek için '#' işaretlerini kaldırın) -----
# Yeni bir cluster eklemek için aşağıdaki satırların başındaki '#' işaretlerini
# silin, node isimlerini kendi sunucularınızla değiştirin ve dosyanın altındaki
# meta gruplarda ilgili 'cluster2_*' satırlarının da '#' işaretini kaldırın.

#[cluster2_master]
#lks-master02
#
#[cluster2_physical_workers]
#lks-physical-worker-02
#
#[cluster2_virtual_workers]
#lks-virtual-worker-02
#
#[cluster2_infra]
#lks-infra02

# -----------------------------------------------------------------------------


# =============================================================================
#  META GRUPLAR - alt grupları otomatik toplayan gruplardır.
#
#  Yeni bir cluster eklerken, o cluster'ın DÖRT satırını da (aşağıdaki dört meta
#  grubun her birinde) yorumdan çıkarmayı unutmayın. Playbook, node'ları bu meta
#  gruplar üzerinden hedefler; buraya eklenmeyen bir cluster görülmez.
# =============================================================================

[all_masters:children]
cluster1_master
#cluster2_master

[all_infras:children]
cluster1_infra
#cluster2_infra

[all_physical_workers:children]
cluster1_physical_workers
#cluster2_physical_workers

[all_virtual_workers:children]
cluster1_virtual_workers
#cluster2_virtual_workers


# =============================================================================
#  TÜM HOST'LARA UYGULANAN DEĞİŞKENLER
# =============================================================================

[all:vars]

kubernetes_version="1.35"
hide_logs=false
