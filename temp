- name: API sunucusu ayağa kalkana kadar bekle
  ansible.builtin.command: >-
    kubectl get --raw=/healthz --kubeconfig {{ kubeconfig_path }}
  register: healthz
  until: healthz.rc == 0 and healthz.stdout == "ok"
  retries: 30
  delay: 10
  changed_when: false

- name: Kontrol düzlemi bileşen sağlığı
  ansible.builtin.command: >-
    kubectl get --raw={{ item }} --kubeconfig {{ kubeconfig_path }}
  register: comp_health
  until: comp_health.rc == 0
  retries: 12
  delay: 10
  changed_when: false
  loop:
    - /livez
    - /readyz
    - /readyz/etcd
