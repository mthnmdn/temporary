---
# =============================================================================
# NODE DECOM - ON DOGRULAMA (SALT-OKUNUR)
# =============================================================================
# Hicbir sey degistirmez. Amaci: envanterin decom icin DOGRU hazirlanmis
# oldugunu garanti etmek. Kontrollerden biri bile basarisiz olursa hicbir
# node'da decom baslamaz.
#
# YAPILAN KONTROLLER
#   1. Decom node'un master'i grup isimlendirmesinden turetilebiliyor mu?
#   2. Master uzerinden API'ye erisilebiliyor mu?
#   3. Node cluster'da gercekten var mi?
#   4. Node control-plane / infra mi? (label + taint)
#   5. Node uzerinde sistem namespace'leri disinda pod var mi?
#   6. Node cordon edilmis mi?
#   7. Drain temiz biter mi? (dry-run)
#   8. Cluster basina decom orani guvenlik esigini asiyor mu?
#
# TASARIM NOTU
#   Kontroller tek tek fail etmez; hepsi kosturulur, hatalar biriktirilir ve
#   sonunda TEK seferde raporlanip play durdurulur. Boylece kullanici tum
#   envanter hatalarini bir turda gorur, deneme-yanilma yapmaz.
# =============================================================================

- name: "Node decom on-dogrulama (salt-okunur)"
  hosts: all_decom
  gather_facts: false
  strategy: linear # any_errors_fatal garantisi icin 'free' KULLANMAYIN
  any_errors_fatal: true

  vars_files:
    - vars/default-variables.yaml

  vars:
    # Envanter hostname'i ile Kubernetes node adi farkliysa host_vars/ altinda
    # k8s_node_name tanimlayarak override edin (FQDN / kisa isim uyusmazligi).
    k8s_node_name: "{{ inventory_hostname }}"

    # Grup isimlendirme sozlesmesinden master'i turet:
    #   <cluster>_decom  ->  <cluster>_master
    my_master: >-
      {{ groups[
           (group_names
             | reject('match', '^all_')
             | select('search', '_decom$')
             | list | first | default('')
             | regex_replace('_decom$', '')
           ) ~ '_master'
         ] | default([]) | first | default('') }}

  tasks:

    - name: "Hata biriktiricisini baslat"
      ansible.builtin.set_fact:
        validation_errors: []
        node_summary: {}

    # =========================================================================
    # ON KOSULLAR - bunlar saglanmazsa diger kontroller anlamsiz, hemen dur
    # =========================================================================

    - name: "ON KOSUL: Node'un master'i grup isimlendirmesinden turetilebildi mi?"
      ansible.builtin.assert:
        that:
          - (my_master | default('')) | length > 0
          - my_master in (groups['all_masters'] | default([]))
        fail_msg: >-
          ENVANTER HATASI - '{{ inventory_hostname }}' icin master bulunamadi.
          Kontrol edin:
          (a) node bir '<cluster>_decom' grubunda olmali,
          (b) ayni '<cluster>' onekiyle bir '<cluster>_master' grubu tanimli olmali,
          (c) her iki grup da 'all_decom' / 'all_masters' meta-gruplarina eklenmis olmali.
        success_msg: "Master: {{ my_master }}"
        quiet: true

    - name: "ON KOSUL: Node hem master hem decom grubunda olmasin"
      ansible.builtin.assert:
        that:
          - inventory_hostname not in (groups['all_masters'] | default([]))
        fail_msg: >-
          ENVANTER HATASI - '{{ inventory_hostname }}' hem 'all_masters' hem
          'all_decom' altinda. Bir node ayni anda master ve decom adayi olamaz.
        quiet: true

    - name: "ON KOSUL: Master uzerinden API erisimi var mi?"
      ansible.builtin.command:
        cmd: "kubectl --kubeconfig {{ kubeconfig_path }} get --raw=/readyz"
      delegate_to: "{{ my_master }}"
      register: api_check
      changed_when: false
      failed_when: false

    - name: "ON KOSUL: API erisimi dogrula"
      ansible.builtin.assert:
        that:
          - api_check.rc == 0
        fail_msg: >-
          '{{ my_master }}' uzerinden Kubernetes API'ye erisilemedi.
          kubeconfig_path ('{{ kubeconfig_path }}') dogru mu, kubectl kurulu mu,
          SSH kullanicisinin bu dosyaya okuma izni var mi? Hata: {{ api_check.stderr | default('') }}
        quiet: true

    # =========================================================================
    # KONTROL 1 - Node cluster'da var mi? [OK]
    # =========================================================================

    - name: "Node bilgisini cek"
      ansible.builtin.command:
        cmd: >-
          kubectl --kubeconfig {{ kubeconfig_path }}
          get node {{ k8s_node_name }} -o json
      delegate_to: "{{ my_master }}"
      register: node_get
      changed_when: false
      failed_when: false

    - name: "[HATA] Node cluster'da bulunamadi"
      ansible.builtin.set_fact:
        validation_errors: >-
          {{ validation_errors + [
             'CLUSTER UYESI DEGIL: ' ~ k8s_node_name ~
             ', ' ~ my_master ~
             ' uzerinden erisilen cluster''da bulunamadi. '
             'Envanterdeki isim Kubernetes node adiyla birebir ayni mi? (kubectl get nodes)'
          ] }}
      when: node_get.rc != 0

    - name: "Node JSON'unu ayristir"
      ansible.builtin.set_fact:
        node_json: "{{ node_get.stdout | from_json }}"
      when: node_get.rc == 0

    # =========================================================================
    # KONTROL 2 - Control-plane / infra node koruma (label + taint) [OK]
    # =========================================================================

    - name: "Korumali label ve taint'leri tespit et"
      ansible.builtin.set_fact:
        _label_hits: >-
          {{ (node_json.metadata.labels | default({}) | list)
             | intersect(protected_node_labels) | list }}
        _taint_hits: >-
          {{ (node_json.spec.taints | default([]) | map(attribute='key') | list)
             | intersect(protected_node_taints) | list }}
      when: node_get.rc == 0

    - name: "[HATA] Node control-plane / infra"
      ansible.builtin.set_fact:
        validation_errors: >-
          {{ validation_errors + [
             'KORUMALI NODE: ' ~ node_json.metadata.name ~
             ' | Sadece worker node decom edilebilir.' ~
             ' | Bulunan label: ' ~ (_label_hits | join(', ') | default('-', true)) ~
             ' | Bulunan taint: ' ~ (_taint_hits | join(', ') | default('-', true)) ~
             ' | Bu node''u decom listesinden cikarin.'
             ] }}
      when:
        - node_get.rc == 0
        - (_label_hits | length > 0) or (_taint_hits | length > 0)

    # =========================================================================
    # KONTROL 3 - Node uzerinde sistem disi pod var mi?
    # =========================================================================

    - name: "Node uzerindeki aktif pod'lari listele"
      ansible.builtin.command:
        cmd: >-
          kubectl --kubeconfig {{ kubeconfig_path }}
          get pods --all-namespaces
          --field-selector spec.nodeName={{ k8s_node_name }},status.phase!=Succeeded,status.phase!=Failed
          -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}/{.metadata.ownerReferences[0].kind}{"\n"}{end}'
      delegate_to: "{{ my_master }}"
      register: pods_raw
      changed_when: false
      failed_when: false
      when: node_get.rc == 0

    - name: "Sistem namespace'lerini ve (opsiyonel) DaemonSet pod'larini ele"
      ansible.builtin.set_fact:
        _blocking_pods: >-
          {{ (pods_raw.stdout_lines | default([]))
             | reject('match', '^(' ~ (system_namespaces | join('|')) ~ ')/')
             | list }}
      when:
        - node_get.rc == 0
        - pods_raw.rc == 0

    - name: "DaemonSet pod'larini ele (allow_daemonset_pods=true ise)"
      ansible.builtin.set_fact:
        _blocking_pods: "{{ _blocking_pods | reject('search', '/DaemonSet$') | list }}"
      when:
        - node_get.rc == 0
        - pods_raw.rc == 0
        - allow_daemonset_pods | bool

    - name: "[HATA] Node uzerinde uygulama pod'lari var"
      ansible.builtin.set_fact:
        validation_errors: >-
          {{ validation_errors + [
             'NODE BOS DEGIL: ' ~ node_json.metadata.name ~
             ' | ' ~ (_blocking_pods | length) ~ ' adet sistem-disi pod calisiyor -> ' ~
             (_blocking_pods[:10] | join(', ')) ~
             (' ...(+' ~ (_blocking_pods | length - 10) ~ ' pod daha)'
              if (_blocking_pods | length) > 10 else '') ~
             '. Bunlari tasiyin ya da namespace''leri sistem bileseniyse ' ~
             'vars/default-variables.yaml icindeki system_namespaces listesine ekleyin.'
             ] }}
      when:
        - node_get.rc == 0
        - pods_raw.rc == 0
        - (_blocking_pods | default([]) | length) > 0

    # =========================================================================
    # KONTROL 4 - Cordon durumu
    # =========================================================================

    - name: "Cordon durumunu tespit et"
      ansible.builtin.set_fact:
        _is_cordoned: "{{ node_json.spec.unschedulable | default(false) | bool }}"
      when: node_get.rc == 0

    - name: "[HATA] Node cordon edilmemis"
      ansible.builtin.set_fact:
        validation_errors: >-
          {{ validation_errors + [
             'CORDON EDILMEMIS: node hala schedulable. Decom oncesi
              "kubectl cordon ' ~ k8s_node_name ~ '" calistirin.
              (Bu sarti kaldirmak icin require_cordoned: false)'
             ] }}
      when:
        - node_get.rc == 0
        - require_cordoned | bool
        - not _is_cordoned

    # =========================================================================
    # KONTROL 5 - Drain dry-run
    # =========================================================================

    - name: "Drain dry-run"
      ansible.builtin.command:
        cmd: >-
          kubectl --kubeconfig {{ kubeconfig_path }}
          drain {{ k8s_node_name }}
          --ignore-daemonsets
          --delete-emptydir-data
          --dry-run=server
      delegate_to: "{{ my_master }}"
      register: drain_dry
      changed_when: false
      failed_when: false
      when: node_get.rc == 0

    - name: "[HATA] Drain temiz bitmeyecek"
      ansible.builtin.set_fact:
        validation_errors: >-
          {{ validation_errors + [
             'DRAIN SORUNLU: dry-run basarisiz. Muhtemel sebep PDB ihlali,
              emptyDir verisi ya da controller''i olmayan bare pod.
              Detay: ' ~ (drain_dry.stderr | default('') | truncate(300))
             ] }}
      when:
        - node_get.rc == 0
        - drain_dryrun_fatal | bool
        - drain_dry.rc != 0

    - name: "[UYARI] Drain dry-run basarisiz (fatal degil)"
      ansible.builtin.debug:
        msg: "UYARI - drain sorunlu olabilir: {{ drain_dry.stderr | default('') | truncate(300) }}"
      when:
        - node_get.rc == 0
        - not (drain_dryrun_fatal | bool)
        - drain_dry.rc != 0

    # =========================================================================
    # NODE OZETI
    # =========================================================================

    - name: "Node ozeti"
      ansible.builtin.debug:
        msg:
          - "node          : {{ k8s_node_name }}"
          - "master        : {{ my_master }}"
          - "cluster uyesi : {{ 'EVET' if node_get.rc == 0 else 'HAYIR' }}"
          - "rol           : {{ 'KORUMALI (control-plane/infra)' if (node_get.rc == 0 and ((_label_hits | default([]) | length) > 0 or (_taint_hits | default([]) | length) > 0)) else 'worker' }}"
          - "cordon        : {{ (_is_cordoned | default(false)) | ternary('EVET', 'HAYIR') }}"
          - "engelleyen pod: {{ _blocking_pods | default([]) | length }}"
          - "drain dry-run : {{ 'TEMIZ' if (drain_dry.rc | default(1)) == 0 else 'SORUNLU' }}"
          - "SONUC         : {{ 'GECTI' if (validation_errors | length) == 0 else (validation_errors | length) ~ ' HATA' }}"
      when: node_get.rc == 0 or true

    # =========================================================================
    # TEK NOKTADAN KARAR - burada patlarsa TUM play (tum node'lar) durur
    # =========================================================================

    - name: "DOGRULAMA SONUCU"
      ansible.builtin.assert:
        that:
          - (validation_errors | length) == 0
        fail_msg: >-

          =====================================================================
          DOGRULAMA BASARISIZ -> {{ inventory_hostname }}
          =====================================================================
          {% for e in validation_errors %}
          [{{ loop.index }}] {{ e }}
          {% endfor %}
          =====================================================================
          Decom BASLATILMADI. Envanteri/ortami duzeltip playbook'u tekrar calistirin.
        success_msg: "{{ inventory_hostname }} -> decom icin hazir."
        quiet: true
