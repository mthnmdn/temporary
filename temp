# ------------------------------------------------------
# 5. kube-controller-manager sağlıklı mı?
# ------------------------------------------------------
- name: Wait until kube-controller-manager is healthy
  ansible.builtin.uri:
    url: https://127.0.0.1:10257/healthz
    validate_certs: false
    return_content: true
    status_code: 200
  register: controller_manager_health
  changed_when: false
  failed_when: false
  retries: 30
  delay: 5
  until:
    - controller_manager_health.status == 200
    - controller_manager_health.content | trim == "ok"


