- name: Get Tokens
  hosts: all_masters
  no_log: "{{ hide_logs | default(true) | bool }}"
  become: true
  gather_facts: false
  vars_files:
    - vars/default-variables.yaml
  tasks:
    - name: Generate Join Command
      ansible.builtin.command: |
        kubeadm token create --ttl 30m --print-join-command --kubeconfig {{ kubeconfig_path }}
      register: join_command_output
      changed_when: false

    - name: Store join command as a fact on master
      ansible.builtin.set_fact:
        join_command: "{{ join_command_output.stdout }}"

- name: Add new worker
  hosts: all_physical_workers:all_virtual_workers:all_infras
  no_log: "{{ hide_logs | default(true) | bool }}"
  become: true
  gather_facts: false
  vars_files:
    - vars/default-variables.yaml
  vars:
    # Bu node'un ait oldugu cluster'i group_names'ten cikar ( or. cluster1).
    cluster_id: >-
      {{ group_names | select('match', '^cluster[0-9]+_') | first | regex_replace('_.*$', '') }}
    # Bu cluster'in master node'u.
    master_host: "{{ groups[cluster_id + '_master'][0] }}"
  tasks:

    - name: Copy kubernetes.sh to workers
      ansible.builtin.copy:
        src: ./files/kubernetes-{{ kubernetes_version }}.sh
        dest: /tmp/kubernetes-{{ kubernetes_version }}.sh
        mode: '0755'

#    - name: Fix CRLF
#      ansible.builtin.command: "sed -i 's/\r$//' /tmp/kubernetes-{{ kubernetes_version }}.sh"
#      #when: false

    - name: Execute kubernetes.sh
      ansible.builtin.command: |
        /tmp/kubernetes-{{ kubernetes_version }}.sh
      args:
        creates: /usr/lib/systemd/system/kubelet.service.d

    - name: Delete kubernetes.sh
      ansible.builtin.file:
        path: /tmp/kubernetes-{{ kubernetes_version }}.sh
        state: absent

    - name: Add new worker
      ansible.builtin.command: |
        {{ hostvars[master_host]['join_command'] }} --node-name {{ inventory_hostname }}
      args:
        creates: /etc/kubernetes/kubelet.conf

    - name: Set kubelet conf
      ansible.builtin.copy:
        src: >-
          {{
            physical_kubelet_config_source
            if inventory_hostname in (groups['all_physical_workers'] | default([]))
            else (
              infra_kubelet_config_source
              if inventory_hostname in (groups['all_infras'] | default([]))
              else virtual_kubelet_config_source
            )
          }}
        dest: /var/lib/kubelet/config.yaml
        owner: root
        group: root
        mode: '0640'
      notify: Restart kubelet

  handlers:
    - name: Restart kubelet
      ansible.builtin.systemd:
        name: kubelet
        state: restarted
        daemon_reload: true

- name: Label and Taint New Workers
  hosts: all_masters
  no_log: "{{ hide_logs | default(true) | bool }}"
  become: true
  gather_facts: false
  vars_files:
    - vars/default-variables.yaml
  vars:
    # Bu master'in ait oldugu cluster'i group_names'ten cikar (or. cluster1).
    cluster_id: >-
      {{ group_names | select('match', '^cluster[0-9]+_') | first | regex_replace('_.*$', '') }}
  tasks:

    - name: Label physical workers
      ansible.builtin.command: |
        kubectl label no {{ worker }} {{ physical_worker_labels }} --kubeconfig {{ kubeconfig_path }} --overwrite
      loop: "{{ groups[cluster_id + '_physical_workers'] | default([]) }}"
      loop_control:
        loop_var: worker

    - name: Label virtual workers
      ansible.builtin.command: |
        kubectl label no {{ worker }} {{ virtual_worker_labels }} --kubeconfig {{ kubeconfig_path }} --overwrite
      loop: "{{ groups[cluster_id + '_virtual_workers'] | default([]) }}"
      loop_control:
        loop_var: worker

    - name: Label infra
      ansible.builtin.command: |
        kubectl label no {{ infra }} {{ infra_labels }} --kubeconfig {{ kubeconfig_path }} --overwrite
      loop: "{{ groups[cluster_id + '_infra'] | default([]) }}"
      loop_control:
        loop_var: infra

    - name: Add taint to worker
      ansible.builtin.command: |
        kubectl taint no {{ worker }} {{ worker_taints }} --kubeconfig {{ kubeconfig_path }} --overwrite
      loop: >-
        {{
          (groups[cluster_id + '_physical_workers'] | default([]))
          + (groups[cluster_id + '_virtual_workers'] | default([]))
        }}
      loop_control:
        loop_var: worker

    - name: Add taint to infra
      ansible.builtin.command: |
        kubectl taint no {{ infra }} {{ infra_taints }} --kubeconfig {{ kubeconfig_path }} --overwrite
      loop: "{{ groups[cluster_id + '_infra'] | default([]) }}"
      loop_control:
        loop_var: infra
