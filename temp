---
# ===========================================================================
# Provizyon (cluster kurulum) doğrulamasına özel AYAR değişkenleri.
#
# Bu dosya YALNIZCA doğrulamanın kendi ayarlarını içerir (eşikler, izin
# verilen değer listeleri, isimlendirme kuralları, zorunlu değişken listesi).
#
# Provizyonun ÇALIŞMA değişkenleri (cluster_name, env, pfx_pass, cilium_repo,
# hub_node, k8s_package_url, ...) burada DEĞİLDİR; onlar kendi dosyalarında
# (vars/default-variables.yaml, vars/node-setup-variables.yaml) ve inventory
# [all:vars] içinde durur. Doğrulama onları yalnızca DENETLER, taşımaz.
#
# Türetilmiş değerler (invalid_named_hosts, expected_pfx_path, min_disk_bytes)
# playbook içinde hesaplanır; buraya konmaz.
#
# Yükleyen play'ler:  vars_files: [vars/default-validation-variables.yaml]
# ===========================================================================

# ---- Grup boyutu asgari gereksinimleri (global) --------------------------
min_master_count: 3
min_infra_count: 3

# ---- İsimlendirme kuralları ----------------------------------------------
# cluster_name bu regex ile başlamalı.
valid_cluster_name_regex: '^k8s'
# Her host adı bu regex ile başlamalı.
valid_host_name_regex: '^(lks|lk8s)'

# ---- İzin verilen değerler + tutarlılık eşlemesi -------------------------
allowed_env:
  - test
  - production
  - dmz

allowed_cluster_env:
  - TEMP_PRODUCTION
  - TEMP_TEST
  - TEMP_DMZDMN

# env -> cluster_env tutarlılık eşlemesi
env_cluster_env_map:
  test: TEMP_TEST
  production: TEMP_PRODUCTION
  dmz: TEMP_DMZDMN

# ---- Inventory'de tanımlı ve boş olmaması gereken zorunlu değişkenler -----
# Yeni bir zorunlu değişken eklemek = bu listeye bir satır eklemek.
required_vars:
  - cluster_name
  - company_name
  - business
  - domain
  - env
  - pfx_pass
  - username
  - cluster_env
  - kubeconfig_path
  - physical_kubelet_config_source
  - virtual_kubelet_config_source
  - infra_kubelet_config_source
  - physical_worker_labels
  - virtual_worker_labels
  - infra_labels
  - infra_taints
  - pod_cidr
  - service_cidr
  - cilium_repo
  - hub_node
  - setup_dir
  - k8s_package_url
  - proxy_http
  - proxy_no_proxy
  - artifacthub_ca_certificate_src
  - registry_mirror

# ---- Dosya varlığı kontrolleri -------------------------------------------
# pfx dosyası: files/ altında 'ingress-<cluster_name>.pfx' beklenir.
expected_pfx_name_template: "ingress-{{ cluster_name }}.pfx"
# SSH key: git node (master[0]) üzerinde bu yolda beklenir.
expected_ssh_key_path: "/root/.ssh/tfs_k8s_id_rsa"

# ---- Node (uzak) kontrol eşikleri ----------------------------------------
min_node_cpu: 16            # çekirdek
min_node_memory_mb: 62000   # ~64 GB
data_dirs:
  - /var/lib/containerd
  - /var/lib/kubelet
min_disk_gb: 490
required_free_ports:
  - 10250   # kubelet API
  - 10256   # kube-proxy health check
