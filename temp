- name: Hub node'unu dinamik olarak tanımla
  hosts: localhost
  gather_facts: false
  vars_files:
    - vars/default-variables.yaml
  tasks:
    - name: Hub node'unu ekle
      add_host:
        name: "{{ hub_node }}"
        groups: hub

- name: Hub üzerinde çalış
  hosts: hub
  tasks:
    - name: Örnek görev
      debug:
        msg: "{{ inventory_hostname }} üzerinde çalışıyorum"
