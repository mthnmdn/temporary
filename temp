- name: Enable grpc histogram
  ansible.builtin.replace:
    path: /etc/containerd/config.toml
    regexp: 'grpc_histogram = false'
    replace: 'grpc_histogram = true'

- name: Set metrics address (single quotes)
  ansible.builtin.replace:
    path: /etc/containerd/config.toml
    regexp: "(\\[plugins\\.'io\\.containerd\\.server\\.v1\\.metrics'\\][\\s\\S]*?)address = ''"
    replace: "\\1address = '0.0.0.0:1338'"

- name: Set metrics address (double quotes)
  ansible.builtin.replace:
    path: /etc/containerd/config.toml
    regexp: '(\[plugins\."io\.containerd\.server\.v1\.metrics"\][\s\S]*?)address = ""'
    replace: '\1address = "0.0.0.0:1338"'
