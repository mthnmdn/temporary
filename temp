# modüllerin idempotent olup olmadığını kontrol et. modüllerde state kullanımına bak.
# birden fazla cluster'a ekleme yapmaya bak.
- name: Get Tokens
  hosts: master[0]
  no_log: "{{ hide_logs | default(true) | bool }}"
  become: true
  gather_facts: false
  vars_files:
    - vars/default-variables.yaml
  tasks:
    - name: Generate Join Command
      ansible.builtin.command: |
        kubeadm token create --ttl 30m --print-join-command --kubeconfig {{ kubeconfig }}
      register: join_command_output
      changed_when: false
      #when: false

    - name: Store join command as a fact on master
      ansible.builtin.set_fact:
        join_command: "{{ join_command_output.stdout }}"
      #when: false

- name: Add new worker
  hosts: workers:infra
  no_log: "{{ hide_logs | default(true) | bool }}"
  become: true
  gather_facts: false
  vars_files:
    - vars/default-variables.yaml
  tasks:

    - name: Copy kubernetes.sh to workers
      ansible.builtin.copy:
        src: ./files/kubernetes-{{ kubernetes_version }}.sh
        dest: /tmp/kubernetes-{{ kubernetes_version }}.sh
        mode: '0755'
      #when: false

#    - name: Fix CRLF
#      ansible.builtin.command: "sed -i 's/\r$//' /tmp/kubernetes-{{ kubernetes_version }}.sh"
#      #when: false

    - name: Execute kubernetes.sh
      ansible.builtin.command: |
        /tmp/kubernetes-{{ kubernetes_version }}.sh
      #when: false
      args:
        creates: /usr/lib/systemd/system/kubelet.service.d

    - name: Delete kubernetes.sh
      ansible.builtin.file:
        path: /tmp/kubernetes-{{ kubernetes_version }}.sh
        state: absent

    - name: Add new worker
      # Join komutu master host'unun fact'inden okunuyor.
      ansible.builtin.command: |
        {{ hostvars[groups['master'][0]]['join_command'] }} --node-name {{ inventory_hostname }}
      args:
        creates: /etc/kubernetes/kubelet.conf
      #when: false

    - name: Set kubelet conf
      # Host physical_workers grubundaysa physical, infra grubundaysa infra,
      # aksi halde virtual kubelet config kullanılır.
      ansible.builtin.copy:
        src: >-
          {{
            physical_kubelet_config_source
            if inventory_hostname in (groups['physical_workers'] | default([]))
            else (
              infra_kubelet_config_source
              if inventory_hostname in (groups['infra'] | default([]))
              else virtual_kubelet_config_source
            )
          }}
        dest: /var/lib/kubelet/config.yaml
        owner: root
        group: root
        mode: '0640'
      notify: Restart kubelet
      #when: false

  handlers:
    - name: Restart kubelet
      ansible.builtin.systemd:
        name: kubelet
        state: restarted
        daemon_reload: true

- name: Label and Taint New Workers
  hosts: master[0]
  no_log: "{{ hide_logs | default(true) | bool }}"
  become: true
  gather_facts: false
  vars_files:
    - vars/default-variables.yaml
  tasks:

    - name: Label physical workers
      #when: false
      ansible.builtin.command: |
        kubectl label no {{ worker }} {{ physical_worker_labels }} --kubeconfig {{ kubeconfig }}
      loop: "{{ groups['physical_workers'] | default([]) }}"
      loop_control:
        loop_var: worker

    - name: Label virtual workers
      #when: false
      ansible.builtin.command: |
        kubectl label no {{ worker }} {{ virtual_worker_labels }} --kubeconfig {{ kubeconfig }}
      loop: "{{ groups['virtual_workers'] | default([]) }}"
      loop_control:
        loop_var: worker

    - name: Label infra workers
      #when: false
      ansible.builtin.command: |
        kubectl label no {{ worker }} {{ infra_worker_labels }} --kubeconfig {{ kubeconfig }}
      loop: "{{ groups['infra'] | default([]) }}"
      loop_control:
        loop_var: worker

    - name: Add taint to worker
      # workers grubundaki node'lara ortak taint uygulanır (infra ayrı grup).
      #when: false
      ansible.builtin.command: |
        kubectl taint no {{ worker }} {{ default_worker_taints }} --kubeconfig {{ kubeconfig }}
      loop: "{{ groups['workers'] | default([]) }}"
      loop_control:
        loop_var: worker

    - name: Add taint to infra worker
      # Infra sunucularına kendi taint'i uygulanır.
      #when: false
      ansible.builtin.command: |
        kubectl taint no {{ worker }} {{ infra_worker_taints }} --kubeconfig {{ kubeconfig }}
      loop: "{{ groups['infra'] | default([]) }}"
      loop_control:
        loop_var: worker

