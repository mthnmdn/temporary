    - name: Check for staged changes
      ansible.builtin.command: git status --porcelain
      args:
        chdir: /tmp/{{ repo_name }}/
      register: git_status
      changed_when: false

    - name: Commit changes (only when there is something to commit)
      ansible.builtin.command: git commit -m "Provision cluster {{ cluster_name }}"
      args:
        chdir: /tmp/{{ repo_name }}/
      when: git_status.stdout | trim | length > 0
      register: git_commit
      changed_when: git_commit.rc == 0
