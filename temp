# ------------------------------------------------------
# 1. Node API'ye register olmuş mu?
# CNI olmadığı için Ready=True beklemiyoruz.
# ------------------------------------------------------
- name: Wait until primary node is registered
  ansible.builtin.command: >-
    kubectl
    --kubeconfig {{ kubeconfig_path }}
    get node {{ inventory_hostname }}
  register: node_registered
  changed_when: false
  retries: 30
  delay: 5
  until:
    - node_registered.rc == 0


# ------------------------------------------------------
# 2. kube-apiserver live mı?
# ------------------------------------------------------
- name: Wait until kube-apiserver is live
  ansible.builtin.command: >-
    kubectl
    --kubeconfig {{ kubeconfig_path }}
    get --raw=/livez
  register: apiserver_livez
  changed_when: false
  retries: 30
  delay: 5
  until:
    - apiserver_livez.rc == 0
    - apiserver_livez.stdout | trim == "ok"


# ------------------------------------------------------
# 3. kube-apiserver ready mi?
# ------------------------------------------------------
- name: Wait until kube-apiserver is ready
  ansible.builtin.command: >-
    kubectl
    --kubeconfig {{ kubeconfig_path }}
    get --raw=/readyz
  register: apiserver_readyz
  changed_when: false
  retries: 30
  delay: 5
  until:
    - apiserver_readyz.rc == 0
    - apiserver_readyz.stdout | trim == "ok"


# ------------------------------------------------------
# 4. API server -> etcd bağlantısı sağlıklı mı?
# ------------------------------------------------------
- name: Wait until kube-apiserver etcd check is ready
  ansible.builtin.command: >-
    kubectl
    --kubeconfig {{ kubeconfig_path }}
    get --raw=/readyz/etcd
  register: apiserver_etcd
  changed_when: false
  retries: 30
  delay: 5
  until:
    - apiserver_etcd.rc == 0
    - apiserver_etcd.stdout | trim == "ok"


# ------------------------------------------------------
# 5. kube-controller-manager sağlıklı mı?
# ------------------------------------------------------
- name: Wait until kube-controller-manager is healthy
  ansible.builtin.command: >-
    curl
    --silent
    --show-error
    --fail
    --insecure
    https://127.0.0.1:10257/healthz
  register: controller_manager_health
  changed_when: false
  retries: 30
  delay: 5
  until:
    - controller_manager_health.rc == 0
    - controller_manager_health.stdout | trim == "ok"


# ------------------------------------------------------
# 6. kube-scheduler sağlıklı mı?
# ------------------------------------------------------
- name: Wait until kube-scheduler is healthy
  ansible.builtin.command: >-
    curl
    --silent
    --show-error
    --fail
    --insecure
    https://127.0.0.1:10259/healthz
  register: scheduler_health
  changed_when: false
  retries: 30
  delay: 5
  until:
    - scheduler_health.rc == 0
    - scheduler_health.stdout | trim == "ok"


# ------------------------------------------------------
# 7. Local etcd endpoint sağlıklı mı?
# ------------------------------------------------------
- name: Wait until local etcd is healthy
  ansible.builtin.command: >-
    kubectl
    --kubeconfig {{ kubeconfig_path }}
    -n kube-system
    exec etcd-{{ inventory_hostname }}
    --
    etcdctl
    --endpoints=https://127.0.0.1:2379
    --cacert=/etc/kubernetes/pki/etcd/ca.crt
    --cert=/etc/kubernetes/pki/etcd/healthcheck-client.crt
    --key=/etc/kubernetes/pki/etcd/healthcheck-client.key
    endpoint health
  register: etcd_health
  changed_when: false
  retries: 30
  delay: 5
  until:
    - etcd_health.rc == 0


# ------------------------------------------------------
# 8. İlk etcd member doğru oluşmuş mu?
# ------------------------------------------------------
- name: Verify primary etcd membership
  ansible.builtin.command: >-
    kubectl
    --kubeconfig {{ kubeconfig_path }}
    -n kube-system
    exec etcd-{{ inventory_hostname }}
    --
    etcdctl
    --endpoints=https://127.0.0.1:2379
    --cacert=/etc/kubernetes/pki/etcd/ca.crt
    --cert=/etc/kubernetes/pki/etcd/healthcheck-client.crt
    --key=/etc/kubernetes/pki/etcd/healthcheck-client.key
    member list
  register: etcd_members
  changed_when: false
  retries: 10
  delay: 5
  until:
    - etcd_members.rc == 0
    - inventory_hostname in etcd_members.stdout


# ------------------------------------------------------
# 9. Validation başarılı
# ------------------------------------------------------
- name: Primary control plane validation successful
  ansible.builtin.debug:
    msg: |
      {{ inventory_hostname }} control plane validation başarılı.

      Node registration        : OK
      kube-apiserver live      : OK
      kube-apiserver ready     : OK
      API -> etcd              : OK
      kube-controller-manager  : OK
      kube-scheduler           : OK
      etcd endpoint            : OK
      etcd membership          : OK
