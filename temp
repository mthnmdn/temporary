---
# ===========================================================================
# Validation-specific settings (thresholds / policy values only).
#
# This file holds ONLY tunable settings. Derived/computed values
# (cluster_ids, orphan_hosts, min_disk_bytes, ...) stay in the playbook,
# because they are calculated from 'groups' at run time and are not meant
# to be edited here.
#
# Loaded by 00-validate-inventory via:  vars_files: [vars/validation-variables.yaml]
# ===========================================================================

# ---- Structural (Play 1) -------------------------------------------------

# Role suffixes that make up a cluster. Adding a new role here (e.g.
# gpu_workers) automatically includes it in the existence/overlap checks,
# provided the inventory uses the clusterN_<suffix> naming convention.
role_suffixes:
  - master
  - physical_workers
  - virtual_workers
  - infra

# Allowed kubernetes_version values.
allowed_k8s_versions:
  - "1.33"
  - "1.35"

# Host naming convention: every host name must match this regex.
# (used by the 'invalid_named_hosts' computation in the playbook)
valid_host_name_regex: '^(lks|lk8s)'

# ---- Remote node checks (Play 2) -----------------------------------------

# Minimum hardware requirements per worker/infra node.
min_node_cpu: 16            # cores
min_node_memory_mb: 62000   # ~64 GB

# Data directories that must exist and sit on a large enough dedicated disk.
data_dirs:
  - /var/lib/containerd
  - /var/lib/kubelet

# Minimum disk size (GB) for each data directory's mount point.
min_disk_gb: 490

# Ports that must be free before kubeadm join.
required_free_ports:
  - 10250   # kubelet API
  - 10256   # kube-proxy health check
