---
# =============================================================================
# ORTAK DEGISKENLER
# =============================================================================

# SSH / baglanti
ansible_user: root
# ansible_ssh_private_key_file: ~/.ssh/id_rsa

# Master uzerinde kubectl icin kullanilacak kubeconfig yolu
kubeconfig_path: /etc/kubernetes/admin.conf

# Decom guvenlik esigi: bir cluster'da toplam node'un en fazla yuzde kaci
# ayni calistirmada silinebilir. Asilirsa validation FAIL verir.
max_decom_percent: 34

# drain davranisi
drain_timeout: 300          # saniye
drain_grace_period: -1      # -1 = pod'un kendi terminationGracePeriod'u

# -----------------------------------------------------------------------------
# Bir decom host'unun ait oldugu cluster'in master host adini,
# grup ismi konvansiyonundan otomatik turetir:
#   "<cluster>_decom" grubuna uye host  ->  "<cluster>_master" grubunun tek uyesi
# Boylece kullanici envantere ekstra "hangi master" bilgisi girmez.
# -----------------------------------------------------------------------------
_cluster_name: >-
  {{ (group_names | reject('match', '^all_') | select('match', '.*_decom$') | list | first | default('')) | regex_replace('_decom$', '') }}

my_master_group: "{{ _cluster_name ~ '_master' }}"

# Bu host'un cluster'inin master inventory_hostname'i
my_master: "{{ (groups[my_master_group] | default([]) | first) | default('') }}"
