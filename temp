    - name: Check if cluster directory already prepared
      ansible.builtin.stat:
        path: /tmp/{{ repo_name }}/cluster-core/clusters/{{ cluster_name }}
      register: cluster_dir

    - name: Copy cluster manifests from TEMP template (only if not prepared)
      ansible.builtin.copy:
        src: /tmp/{{ repo_name }}/cluster-core/clusters/TEMP/
        dest: /tmp/{{ repo_name }}/cluster-core/clusters/{{ cluster_name }}/
        remote_src: true
        owner: root
        group: root
        mode: preserve
      when: not cluster_dir.stat.exists
