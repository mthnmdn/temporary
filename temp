# =============================================================================
#  KUBERNETES NODE EKLEME - INVENTORY
# =============================================================================
#
#  Bu dosyayi duzenleyip playbook'u baslatiyorsunuz. Asagidaki kurallara
#  uyarsaniz validation ve node-ekleme playbook'lari sorunsuz calisir.
#
#  ---------------------------------------------------------------------------
#  NASIL DUZENLENIR
#  ---------------------------------------------------------------------------
#  1) Node eklemek istediginiz cluster'in ilgili grubuna, eklenecek
#     sunucunun adini yazin (her satira bir sunucu).
#
#  2) YENI BIR CLUSTER eklemek icin:
#       - Asagidaki "CLUSTER 2" sablonundaki '#' yorum isaretlerini kaldirin
#         (grup basliklari ve node satirlari dahil).
#       - Node isimlerini kendi sunucularinizla degistirin.
#       - Dosyanin altindaki meta-gruplarda (all_masters, all_infras,
#         all_physical_workers, all_virtual_workers) ilgili cluster satirlarinin
#         da '#' isaretini kaldirin. BU ADIM ZORUNLU - meta-gruplari
#         guncellemezseniz yeni cluster playbook tarafindan gorulmez.
#       - Daha fazla cluster (cluster3, cluster4, ...) icin ayni sablonu
#         kopyalayip cluster numarasini artirin.
#
#  ---------------------------------------------------------------------------
#  ISIMLENDIRME KURALLARI (validation bunlari kontrol eder)
#  ---------------------------------------------------------------------------
#  * Grup isimleri 'clusterN_<rol>' biciminde olmali. Gecerli roller:
#       _master  _physical_workers  _virtual_workers  _infra
#    N yerine cluster numarasi gelir (cluster1, cluster2, ...). Bu isimlendirme
#    playbook'un "hangi node hangi cluster'a ait" iliskisini kurmasini saglar.
#
#  * Her SUNUCU ADI 'lks' veya 'lk8s' ile baslamak zorundadir.
#    Ornek gecerli:   lks-master01,  lk8s-worker-01
#    Ornek gecersiz:  master01,  node1   (validation bunlari reddeder)
#
#  * Bir sunucu ayni cluster icinde YALNIZCA BIR role grubunda olabilir
#    (ornegin hem physical hem virtual olamaz).
#
#  * Bir sunucu YALNIZCA BIR cluster'a ait olabilir; ayni sunucu adini
#    baska bir cluster'in gruplarina yazmayin.
#
#  * Her cluster'in bir master'i olmali ve en az bir worker VEYA infra
#    node'u bulunmali (yalnizca worker, yalnizca infra veya ikisi de olabilir).
#
#  ---------------------------------------------------------------------------
#  DEGISKENLER
#  ---------------------------------------------------------------------------
#  Dosyanin en altindaki [all:vars] bolumunde:
#    * kubernetes_version : Kurulacak surum. Yalnizca izin verilen
#                           degerlerden biri olabilir (or. "1.33" veya "1.35").
#    * hide_logs          : true  -> hassas ciktilar gizlenir
#                           false -> ayrintili ciktiyi ekranda gorursunuz
# =============================================================================


# ----- CLUSTER 1 -------------------------------------------------------------
# Bu cluster aktif. Node eklemek icin ilgili grubun altina sunucu adi yazin.

[cluster1_master]
lks-master01

[cluster1_physical_workers]
lks-physical-worker-01

[cluster1_virtual_workers]
lks-virtual-worker-01

[cluster1_infra]
lks-infra01


# ----- CLUSTER 2 (SABLON - yeni cluster eklemek icin '#' isaretlerini kaldirin) -----
# Yeni bir cluster eklemek icin asagidaki satirlarin basindaki '#' isaretlerini
# silin, node isimlerini kendi sunucularinizla degistirin ve dosyanin altindaki
# meta-gruplarda ilgili 'cluster2_*' satirlarinin da '#' isaretini kaldirin.

#[cluster2_master]
#lks-master02
#
#[cluster2_physical_workers]
#lks-physical-worker-02
#
#[cluster2_virtual_workers]
#lks-virtual-worker-02
#
#[cluster2_infra]
#lks-infra02

# -----------------------------------------------------------------------------


# =============================================================================
#  META-GRUPLAR - alt gruplari otomatik toplayan gruplar.
#
#  Yeni bir cluster eklerken, o cluster'in DORT satirini da (asagidaki dort
#  meta-grubun her birinde) yorumdan cikarmayi unutmayin. Playbook node'lari
#  bu meta-gruplar uzerinden hedefler; buraya eklenmeyen bir cluster gorulmez.
# =============================================================================

[all_masters:children]
cluster1_master
#cluster2_master

[all_infras:children]
cluster1_infra
#cluster2_infra

[all_physical_workers:children]
cluster1_physical_workers
#cluster2_physical_workers

[all_virtual_workers:children]
cluster1_virtual_workers
#cluster2_virtual_workers


# =============================================================================
#  TUM HOST'LARA UYGULANAN DEGISKENLER
# =============================================================================

[all:vars]

kubernetes_version="1.35"
hide_logs=false
