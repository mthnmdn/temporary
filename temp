- name: Kernel modüllerini şimdi yükle
  ansible.builtin.shell: |
    if ! lsmod | grep -q "^{{ item }}\b"; then
      modprobe {{ item }} && echo CHANGED
    fi
  loop: "{{ kernel_modules }}"
  register: modprobe_result
  changed_when: "'CHANGED' in modprobe_result.stdout"
  failed_when: modprobe_result.rc != 0
