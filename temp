    - name: Configure git identity (repo-local)
      ansible.builtin.command: git config --local {{ item.key }} "{{ item.value }}"
      args:
        chdir: /tmp/{{ repo_name }}/
      loop:
        - { key: "user.email", value: "{{ username }}@akbank.com" }
        - { key: "user.name", value: "{{ username }}" }
        - { key: "core.sshCommand", value: "ssh -i ~/.ssh/tfs_k8s_id_rsa" }
      loop_control:
        label: "{{ item.key }}"
      changed_when: false
