---
# =============================================================================
# DECOM PLAYBOOK
# =============================================================================
# n cluster'dan paralel node decom. Her adim idempotent (tekrar calistirilabilir).
#
# Akis:
#   1) PLAN     - ne silinecegini ekrana bas (salt-okunur)
#   2) GUARD    - 'confirm=yes' verilmeden hicbir yikici islem yapilmaz
#   3) CORDON   - master uzerinde kubectl cordon
#   4) DRAIN    - master uzerinde kubectl drain
#   5) DELETE   - master uzerinde kubectl delete node
#   6) RESET    - decom node'un KENDISI uzerinde kubeadm reset
#   7) CLEANUP  - decom node uzerinde artik temizligi (iptables, cni, .kube ...)
#
# Calistirma (onay platformdan/extra-var'dan gelir, playbook'ta pause yok):
#   ansible-playbook -i inventory/hosts.yml playbooks/decom.yml -e confirm=yes
# =============================================================================

- name: "Node decom"
  hosts: all_decom
  gather_facts: false
  strategy: free            # cluster'lar birbirini beklemesin, paralel ilerlesin
  any_errors_fatal: false

  vars_files:
    - vars/default-variables.yaml

  vars:
    confirm: "no"           # -e confirm=yes verilmeden yikici adimlar atlanir

  tasks:

    # --- 0) Master cozumlemesi ------------------------------------------
    - name: "Cluster master'i bulundu mu?"
      ansible.builtin.assert:
        that:
          - my_master | length > 0
        fail_msg: "'{{ inventory_hostname }}' icin master bulunamadi (grup isimlendirmesini kontrol edin)."
        success_msg: "{{ inventory_hostname }} -> master: {{ my_master }}"

    # --- 1) PLAN (salt-okunur) ------------------------------------------
    - name: "PLAN: silinecek node"
      ansible.builtin.debug:
        msg: >-
          [{{ my_master }}] cluster'indan '{{ inventory_hostname }}'
          cordon -> drain -> delete -> kubeadm reset -> cleanup uygulanacak.

    # --- 2) GUARD -------------------------------------------------------
    - name: "Onay kontrolu"
      ansible.builtin.assert:
        that:
          - confirm | string | lower in ['yes', 'true', 'y', '1']
        fail_msg: >-
          Onay yok. Yikici islemler ATLANDI. Devam icin: -e confirm=yes
        success_msg: "Onay alindi, decom basliyor."

    # --- Node hala var mi? (idempotency) --------------------------------
    - name: "Node cluster'da mevcut mu?"
      ansible.builtin.command:
        cmd: "kubectl --kubeconfig {{ kubeconfig_path }} get node {{ inventory_hostname }}"
      delegate_to: "{{ my_master }}"
      register: node_exists
      changed_when: false
      failed_when: false

    # --- 3) CORDON ------------------------------------------------------
    - name: "Cordon (yeni pod almasin)"
      ansible.builtin.command:
        cmd: "kubectl --kubeconfig {{ kubeconfig_path }} cordon {{ inventory_hostname }}"
      delegate_to: "{{ my_master }}"
      register: cordon_res
      changed_when: "'already cordoned' not in cordon_res.stdout"
      failed_when: false
      when: node_exists.rc == 0

    # --- 4) DRAIN -------------------------------------------------------
    - name: "Drain (pod'lari tahliye et)"
      ansible.builtin.command:
        cmd: >-
          kubectl --kubeconfig {{ kubeconfig_path }}
          drain {{ inventory_hostname }}
          --ignore-daemonsets
          --delete-emptydir-data
          --force
          --grace-period={{ drain_grace_period }}
          --timeout={{ drain_timeout }}s
      delegate_to: "{{ my_master }}"
      register: drain_res
      changed_when: drain_res.rc == 0
      failed_when: false
      when: node_exists.rc == 0

    - name: "Drain sonucu"
      ansible.builtin.debug:
        msg: "{{ 'Drain OK' if drain_res.rc == 0 else 'Drain uyari/hata: ' ~ (drain_res.stderr | default('')) }}"
      when: node_exists.rc == 0

    # --- 5) DELETE NODE -------------------------------------------------
    - name: "kubectl delete node"
      ansible.builtin.command:
        cmd: >-
          kubectl --kubeconfig {{ kubeconfig_path }}
          delete node {{ inventory_hostname }} --ignore-not-found=true
      delegate_to: "{{ my_master }}"
      register: delete_res
      changed_when: "'deleted' in delete_res.stdout"
      failed_when: delete_res.rc != 0

    - name: "Node cluster'dan silindi"
      ansible.builtin.debug:
        msg: "'{{ inventory_hostname }}' cluster'dan cikarildi."

    # --- 6) KUBEADM RESET (decom node'un KENDISI uzerinde) --------------
    - name: "kubeadm var mi?"
      ansible.builtin.command: "which kubeadm"
      register: has_kubeadm
      changed_when: false
      failed_when: false

    - name: "kubeadm reset --force"
      ansible.builtin.command:
        cmd: "kubeadm reset --force"
      register: reset_res
      changed_when: reset_res.rc == 0
      failed_when: false
      when: has_kubeadm.rc == 0

    - name: "Reset sonucu"
      ansible.builtin.debug:
        msg: "{{ 'kubeadm reset OK' if (reset_res.rc | default(1)) == 0 else 'kubeadm reset atlandi/hata' }}"

    # --- 7) CLEANUP (artik temizligi) ----------------------------------
    - name: "kubelet servisini durdur"
      ansible.builtin.systemd:
        name: kubelet
        state: stopped
        enabled: false
      failed_when: false

    - name: "CNI ag yapilandirmasini temizle"
      ansible.builtin.file:
        path: /etc/cni/net.d
        state: absent

    - name: "Kalan kubernetes/kube dizinlerini temizle"
      ansible.builtin.file:
        path: "{{ item }}"
        state: absent
      loop:
        - /etc/kubernetes
        - /var/lib/kubelet
        - /var/lib/etcd
        - "{{ ansible_env.HOME | default('/root') }}/.kube"

    - name: "iptables kurallarini temizle"
      ansible.builtin.shell:
        cmd: |
          iptables -F || true
          iptables -t nat -F || true
          iptables -t mangle -F || true
          iptables -X || true
      changed_when: true
      failed_when: false

    - name: "IPVS kurallarini temizle (varsa)"
      ansible.builtin.shell:
        cmd: "ipvsadm -C || true"
      changed_when: true
      failed_when: false

    - name: "DECOM TAMAMLANDI"
      ansible.builtin.debug:
        msg: "'{{ inventory_hostname }}' ({{ my_master }} cluster'i) decom edildi ve temizlendi."
