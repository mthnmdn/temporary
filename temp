# ============================================================================
# Node registration doğrulaması
# ----------------------------------------------------------------------------
# Amaç: label/taint (35) atılmadan önce, işlenecek tüm infra + worker
# node'larının Kubernetes API'sine register olduğundan emin olmak.
#
# CNI (cilium) henüz kurulmadığı için node'lar 'NotReady' durumdadır; bu yüzden
# 'Ready' beklemiyoruz - yalnızca node'un API'de KAYITLI (mevcut) olmasını
# bekliyoruz ('kubectl get node <ad>' rc==0).
#
# master[0] üzerinde, kubeconfig_path ile çalışır (bu dosyayı import eden play
# master[0]'ı hedeflemeli ve kubeconfig_path tanımlı olmalıdır).
# ============================================================================

- name: Wait until all infra and worker nodes are registered in the API
  ansible.builtin.command: >-
    kubectl get no {{ item }}
    --kubeconfig {{ kubeconfig_path }}
    -o name
  loop: "{{ (groups['infra'] | default([]))
            + (groups['physical_workers'] | default([]))
            + (groups['virtual_workers'] | default([])) }}"
  register: node_registered
  changed_when: false
  retries: 30
  delay: 5
  until: node_registered.rc == 0
  loop_control:
    label: "{{ item }}"

---

- name: Apply node labels and taints
  hosts: master[0]
  become: true
  gather_facts: false
  vars_files:
    - "../vars/default-variables.yaml"
  tasks:

    - name: Label and taint infra and worker nodes
      block:
        # Label/taint atmadan önce tüm hedef node'lar API'ye register olsun.
        # (NotFound kaynaklı hataların kök nedenini ortadan kaldırır.)
        - name: Validate that all target nodes are registered
          ansible.builtin.import_tasks:
            file: "../validation-tasks/validate-nodes-registered.yaml"

        - name: Label Infra Nodes
          ansible.builtin.command: >-
            kubectl label no {{ item }} {{ infra_labels }}
            --kubeconfig {{ kubeconfig_path }} --overwrite
          loop: "{{ groups['infra'] | default([]) }}"
          register: label_infra
          until: label_infra.rc == 0
          retries: 5
          delay: 5
          changed_when: "'not labeled' not in label_infra.stdout"

        - name: Taint Infra Nodes
          ansible.builtin.command: >-
            kubectl taint no {{ item }} {{ infra_taints }}
            --kubeconfig {{ kubeconfig_path }} --overwrite
          loop: "{{ groups['infra'] | default([]) }}"
          register: taint_infra
          until: taint_infra.rc == 0
          retries: 5
          delay: 5
          changed_when: "'not tainted' not in taint_infra.stdout"

        - name: Label Physical Worker Nodes
          ansible.builtin.command: >-
            kubectl label no {{ item }} {{ physical_worker_labels }}
            --kubeconfig {{ kubeconfig_path }} --overwrite
          loop: "{{ groups['physical_workers'] | default([]) }}"
          register: label_physical
          until: label_physical.rc == 0
          retries: 5
          delay: 5
          changed_when: "'not labeled' not in label_physical.stdout"

        - name: Label Virtual Worker Nodes
          ansible.builtin.command: >-
            kubectl label no {{ item }} {{ virtual_worker_labels }}
            --kubeconfig {{ kubeconfig_path }} --overwrite
          loop: "{{ groups['virtual_workers'] | default([]) }}"
          register: label_virtual
          until: label_virtual.rc == 0
          retries: 5
          delay: 5
          changed_when: "'not labeled' not in label_virtual.stdout"

        # kube-system ns label!!!!
        - name: Label kube-system Namespace
          ansible.builtin.command: >-
            kubectl label ns kube-system monitoring=kube-prometheus-stack
            --kubeconfig {{ kubeconfig_path }} --overwrite
          register: label_ns
          until: label_ns.rc == 0
          retries: 5
          delay: 5
          changed_when: "'not labeled' not in label_ns.stdout"
