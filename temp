---
# cilium-node-cleanup.yml
#
# Bir Cilium worker node'unu bir cluster'dan söküp başka bir Cilium
# cluster'ına taşımadan önce eski cluster'a ait tüm kubelet/CNI/ağ
# durumunu temizler. Sonunda doğrulama yapar.
#
# Kullanım:
#   ansible-playbook -i inventory cilium-node-cleanup.yml \
#     -e "target_node=worker-01" \
#     -e "container_runtime=containerd" \
#     -e "flush_all_firewall=false"
#
# DİKKAT: flush_all_firewall=true node'daki TÜM iptables/nftables
# kurallarını siler, sadece Cilium'unkileri değil. Node'un başka bir
# firewall amacı varsa false bırakın (sadece cilium kurallarını temizler).

# ============================================================
# PLAY 1: Control plane'den node'u çıkar (kontrol makinesinden)
# ============================================================
- name: Drain and delete node from source cluster
  hosts: localhost
  connection: local
  gather_facts: false
  vars:
    target_node: "{{ target_node }}"
  tasks:
    - name: Drain the node
      ansible.builtin.command:
        cmd: >
          kubectl drain {{ target_node }}
          --ignore-daemonsets
          --delete-emptydir-data
          --force
          --timeout=120s
      register: drain_result
      failed_when: false
      changed_when: "'drained' in drain_result.stdout"

    - name: Delete the node object
      ansible.builtin.command:
        cmd: "kubectl delete node {{ target_node }}"
      register: delete_result
      failed_when: false
      changed_when: "'deleted' in delete_result.stdout"

    - name: Show drain/delete results
      ansible.builtin.debug:
        msg:
          - "Drain: {{ drain_result.stdout | default('(atlandı/başarısız)') }}"
          - "Delete: {{ delete_result.stdout | default('(atlandı/başarısız)') }}"

# ============================================================
# PLAY 2: Node üzerinde temizlik
# ============================================================
- name: Clean Cilium and kubelet state on the worker node
  hosts: "{{ target_node }}"
  become: true
  gather_facts: true
  vars:
    container_runtime: "{{ container_runtime | default('containerd') }}"
    flush_all_firewall: "{{ flush_all_firewall | default(false) | bool }}"

  tasks:
    # ---- Servisleri durdur ----
    - name: Stop and disable kubelet
      ansible.builtin.systemd:
        name: kubelet
        state: stopped
        enabled: false
      failed_when: false

    - name: Stop container runtime
      ansible.builtin.systemd:
        name: "{{ container_runtime }}"
        state: stopped
      failed_when: false

    # ---- kubeadm reset ----
    - name: Check for kubeadm binary
      ansible.builtin.command: which kubeadm
      register: kubeadm_check
      failed_when: false
      changed_when: false

    - name: Run kubeadm reset
      ansible.builtin.command:
        cmd: kubeadm reset -f
      when: kubeadm_check.rc == 0
      register: kubeadm_reset
      failed_when: false
      changed_when: kubeadm_reset.rc == 0

    # ---- CNI config ve state ----
    - name: Remove CNI configuration and state directories
      ansible.builtin.file:
        path: "{{ item }}"
        state: absent
      loop:
        - /etc/cni/net.d
        - /var/lib/cni
        - /run/cni

    - name: Recreate empty CNI config dir
      ansible.builtin.file:
        path: /etc/cni/net.d
        state: directory
        mode: "0755"

    # ---- BPF map'leri temizle ----
    - name: Find Cilium BPF objects
      ansible.builtin.find:
        paths: /sys/fs/bpf
        patterns: "cilium*"
        recurse: true
        file_type: any
      register: cilium_bpf
      failed_when: false

    - name: Remove Cilium BPF objects
      ansible.builtin.file:
        path: "{{ item.path }}"
        state: absent
      loop: "{{ cilium_bpf.files | default([]) }}"
      loop_control:
        label: "{{ item.path }}"
      failed_when: false

    - name: Remove cilium tc globals maps
      ansible.builtin.shell:
        cmd: "rm -rf /sys/fs/bpf/tc/globals/cilium_* 2>/dev/null || true"
      changed_when: false

    # ---- Cilium ağ arayüzleri ----
    - name: Gather current network interfaces
      ansible.builtin.setup:
        gather_subset:
          - network
      # facts already gathered; this refreshes interface list

    - name: Delete known Cilium interfaces
      ansible.builtin.command:
        cmd: "ip link delete {{ item }}"
      loop:
        - cilium_host
        - cilium_net
        - cilium_vxlan
        - cilium_geneve
        - cilium_wg0
      register: iface_del
      failed_when: false
      changed_when: iface_del.rc == 0

    - name: Find lxc veth interfaces
      ansible.builtin.shell:
        cmd: >
          ip -o link show | awk -F': ' '{print $2}' |
          cut -d'@' -f1 | grep -E '^lxc' || true
      register: lxc_ifaces
      changed_when: false

    - name: Delete lxc veth interfaces
      ansible.builtin.command:
        cmd: "ip link delete {{ item }}"
      loop: "{{ lxc_ifaces.stdout_lines }}"
      when: lxc_ifaces.stdout_lines | length > 0
      register: lxc_del
      failed_when: false
      changed_when: lxc_del.rc == 0

    # ---- iptables / nftables ----
    - name: Inspect existing cilium iptables rules
      ansible.builtin.shell:
        cmd: "iptables-save 2>/dev/null | grep -i cilium || true"
      register: cilium_iptables
      changed_when: false

    - name: Show cilium iptables rules found
      ansible.builtin.debug:
        var: cilium_iptables.stdout_lines

    # Seçenek A: sadece cilium kurallarını çıkar (flush_all_firewall=false)
    - name: Remove only Cilium iptables rules (IPv4)
      ansible.builtin.shell:
        cmd: "iptables-save | grep -v -i cilium | iptables-restore"
      when: not flush_all_firewall
      changed_when: true
      failed_when: false

    - name: Remove only Cilium iptables rules (IPv6)
      ansible.builtin.shell:
        cmd: "ip6tables-save | grep -v -i cilium | ip6tables-restore"
      when: not flush_all_firewall
      changed_when: true
      failed_when: false

    # Seçenek B: tüm firewall'u sıfırla (flush_all_firewall=true)
    - name: Flush all iptables tables
      ansible.builtin.shell:
        cmd: |
          for table in filter nat mangle raw; do
            iptables -t $table -F
            iptables -t $table -X
            iptables -t $table -Z
          done
          iptables -P INPUT ACCEPT
          iptables -P FORWARD ACCEPT
          iptables -P OUTPUT ACCEPT
      when: flush_all_firewall
      changed_when: true
      failed_when: false

    - name: Delete cilium nftables tables (if nft mode)
      ansible.builtin.shell:
        cmd: |
          nft delete table ip cilium 2>/dev/null || true
          nft delete table ip6 cilium 2>/dev/null || true
      changed_when: false
      failed_when: false

    # ---- State dizinleri ve conntrack ----
    - name: Remove Cilium and kubelet state directories
      ansible.builtin.file:
        path: "{{ item }}"
        state: absent
      loop:
        - /var/run/cilium
        - /run/cilium
        - /var/lib/cilium

    - name: Flush conntrack table
      ansible.builtin.command:
        cmd: conntrack -F
      failed_when: false
      changed_when: false

    # ---- Reboot ----
    - name: Reboot the node to clear kernel-loaded BPF and residual state
      ansible.builtin.reboot:
        reboot_timeout: 600
        msg: "Cilium cleanup - rebooting to clear residual kernel state"

# ============================================================
# PLAY 3: Reboot sonrası doğrulama
# ============================================================
- name: Verify node is clean after reboot
  hosts: "{{ target_node }}"
  become: true
  gather_facts: false

  tasks:
    - name: Check for residual cilium/lxc interfaces
      ansible.builtin.shell:
        cmd: "ip link show | grep -iE 'cilium|lxc' || true"
      register: check_ifaces
      changed_when: false

    - name: Check for residual cilium iptables rules
      ansible.builtin.shell:
        cmd: "iptables-save 2>/dev/null | grep -i cilium || true"
      register: check_iptables
      changed_when: false

    - name: Check for residual cilium nftables rules
      ansible.builtin.shell:
        cmd: "nft list ruleset 2>/dev/null | grep -i cilium || true"
      register: check_nft
      changed_when: false

    - name: Check for residual cilium BPF objects
      ansible.builtin.shell:
        cmd: "find /sys/fs/bpf -name 'cilium*' 2>/dev/null || true"
      register: check_bpf
      changed_when: false

    - name: Check CNI config is empty
      ansible.builtin.shell:
        cmd: "ls -A /etc/cni/net.d/ 2>/dev/null || true"
      register: check_cni
      changed_when: false

    - name: Check kubelet is inactive
      ansible.builtin.command:
        cmd: systemctl is-active kubelet
      register: check_kubelet
      failed_when: false
      changed_when: false

    - name: Report verification results
      ansible.builtin.debug:
        msg:
          - "=== DOĞRULAMA (hepsi boş olmalı) ==="
          - "Arayüzler (cilium/lxc): {{ check_ifaces.stdout_lines | default([]) }}"
          - "iptables cilium: {{ check_iptables.stdout_lines | default([]) }}"
          - "nftables cilium: {{ check_nft.stdout_lines | default([]) }}"
          - "BPF cilium: {{ check_bpf.stdout_lines | default([]) }}"
          - "CNI config: {{ check_cni.stdout_lines | default([]) }}"
          - "kubelet durumu (inactive olmalı): {{ check_kubelet.stdout }}"

    - name: Fail if any residue remains
      ansible.builtin.assert:
        that:
          - check_ifaces.stdout | trim == ""
          - check_iptables.stdout | trim == ""
          - check_nft.stdout | trim == ""
          - check_bpf.stdout | trim == ""
          - check_cni.stdout | trim == ""
        fail_msg: "TEMIZLIK EKSIK - yukarıdaki doğrulama çıktısında kalıntı var. Node'u yeni cluster'a KATMAYIN."
        success_msg: "Node temiz. Yeni cluster'a katılmaya hazır."
